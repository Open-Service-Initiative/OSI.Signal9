{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-solution",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"--configuration",
				"Release"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": false
		},
		{
			"label": "build-debug",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"--configuration",
				"Debug"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": false
		},
		{
			"label": "restore",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"restore"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": false
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"clean"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": false
		},
		{
			"label": "run-agent",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"src/Signal9.Agent"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated"
			}
		},
		{
			"label": "run-webportal",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"src/Signal9.Web"
			],
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated"
			}
		},
		{
			"label": "run-rmm-functions",
			"type": "shell",
			"command": "func",
			"args": [
				"start"
			],
			"options": {
				"cwd": "${workspaceFolder}/Signal9.RMM.Functions"
			},
			"group": "build",
			"problemMatcher": [],
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated"
			}
		},
		{
			"label": "run-web-functions",
			"type": "shell",
			"command": "func",
			"args": [
				"start"
			],
			"options": {
				"cwd": "${workspaceFolder}/Signal9.Web.Functions"
			},
			"group": "build",
			"problemMatcher": [],
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated"
			}
		},
		{
			"label": "docker-build-hub",
			"type": "shell",
			"command": "docker",
			"args": [
				"build",
				"-f",
				"./Signal9.Hub/Dockerfile",
				"-t",
				"signal9-hub",
				"."
			],
			"group": "build",
			"problemMatcher": [],
			"isBackground": false
		},
		{
			"label": "docker-build-webportal",
			"type": "shell",
			"command": "docker",
			"args": [
				"build",
				"-f",
				"./Signal9.WebPortal/Dockerfile",
				"-t",
				"signal9-webportal",
				"."
			],
			"group": "build",
			"problemMatcher": [],
			"isBackground": false
		},
		{
			"label": "test-all",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"test",
				"--configuration",
				"Release",
				"--logger",
				"trx",
				"--collect:\"XPlat Code Coverage\""
			],
			"group": "test",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": false
		},
		{
			"label": "azure-deploy",
			"type": "shell",
			"command": "azd",
			"args": [
				"up"
			],
			"group": "build",
			"problemMatcher": [],
			"isBackground": false
		},
		{
			"label": "azure-provision",
			"type": "shell",
			"command": "azd",
			"args": [
				"provision"
			],
			"group": "build",
			"problemMatcher": [],
			"isBackground": false
		},
		{
			"label": "azure-deploy-code",
			"type": "shell",
			"command": "azd",
			"args": [
				"deploy"
			],
			"group": "build",
			"problemMatcher": [],
			"isBackground": false
		},
		{
			"label": "build: Signal9.Web.Functions",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"--configuration",
				"Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}/Signal9.Web.Functions"
			},
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": false
		},
		{
			"label": "build: Signal9.Agent.Functions",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"--configuration",
				"Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}/Signal9.Agent.Functions"
			},
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": false
		},
		{
			"label": "build: Signal9.Agent",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"--configuration",
				"Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}/Signal9.Agent"
			},
			"group": "build",
			"problemMatcher": [
				"$msCompile"
			],
			"isBackground": false
		},
		{
			"label": "Start Signal9 Platform",
			"dependsOrder": "sequence",
			"dependsOn": [
				"build-debug",
				"run-web-functions",
				"run-rmm-functions",
				"run-webportal"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "clean (functions)",
			"command": "dotnet",
			"args": [
				"clean",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"type": "process",
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}\\Signal9.Web.Functions"
			}
		},
		{
			"label": "build (functions)",
			"command": "dotnet",
			"args": [
				"build",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"type": "process",
			"dependsOn": "clean (functions)",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}\\Signal9.Web.Functions"
			}
		},
		{
			"label": "clean release (functions)",
			"command": "dotnet",
			"args": [
				"clean",
				"--configuration",
				"Release",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"type": "process",
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}\\Signal9.Web.Functions"
			}
		},
		{
			"label": "publish (functions)",
			"command": "dotnet",
			"args": [
				"publish",
				"--configuration",
				"Release",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"type": "process",
			"dependsOn": "clean release (functions)",
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}\\Signal9.Web.Functions"
			}
		},
		{
			"type": "func",
			"dependsOn": "build (functions)",
			"options": {
				"cwd": "${workspaceFolder}\\Signal9.Web.Functions/bin/Debug/net9.0"
			},
			"command": "host start",
			"isBackground": true,
			"problemMatcher": "$func-dotnet-watch"
		}
	]
}