# Normalize line endings in the repository; check out with the platform's native endings.
* text=auto

*.cs      text diff=csharp
*.razor   text
*.csproj  text
*.slnx    text
*.props   text
*.json    text
*.yml     text
*.md      text
*.sh      text eol=lf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.ico     binary
