<span class="badge @Color"><i class="bi @Icon me-1"></i>@Status</span>
@if (MaintenanceMode)
{
    <span class="badge bg-warning text-dark ms-1" title="Maintenance mode: planned downtime"><i class="bi bi-wrench me-1"></i>Maintenance</span>
}

@code {
    [Parameter, EditorRequired] public DeviceStatus Status { get; set; }

    [Parameter] public bool MaintenanceMode { get; set; }

    private string Color => Status == DeviceStatus.Online ? "bg-success" : "bg-danger";

    private string Icon => Status == DeviceStatus.Online ? "bi-check-circle" : "bi-x-circle";
}
