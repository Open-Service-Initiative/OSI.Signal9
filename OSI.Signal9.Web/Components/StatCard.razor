<div class="col-sm-6 col-lg-3 mb-4">
    <div class="card @Color text-white">
        <div class="card-body d-flex justify-content-between">
            <div>
                <h5 class="card-title">@Title</h5>
                <h2 class="card-text mb-0">@(Value?.ToString() ?? "–")</h2>
            </div>
            <i class="bi @Icon fs-1 align-self-center"></i>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public int? Value { get; set; }
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Color { get; set; } = string.Empty;
}
