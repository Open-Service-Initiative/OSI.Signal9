@inject DashboardHubConnection Hub
@implements IDisposable

<span class="badge @(Hub.IsConnected ? "bg-success" : "bg-secondary")" title="Live updates from the API">
    <i class="bi @(Hub.IsConnected ? "bi-wifi" : "bi-wifi-off")"></i> @(Hub.IsConnected ? "Live" : "Offline")
</span>

@code {
    protected override async Task OnInitializedAsync()
    {
        Hub.OnStateChanged += Refresh;
        await Hub.StartAsync();
    }

    private Task Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Hub.OnStateChanged -= Refresh;
}
