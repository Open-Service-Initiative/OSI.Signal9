@page "/devices"
@inject Signal9ApiClient Api
@inject DashboardHubConnection Hub
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Devices - Signal9 RMM</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Devices</h1>
            <p class="text-muted mb-0">Machines enroll themselves when the agent is installed with a tenant code.</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </button>
    </div>

    <ErrorAlert @bind-Message="error" />

    <div class="card mb-3">
        <div class="card-body">
            <form class="row g-3 align-items-end" @onsubmit="LoadAsync">
                <div class="col-md-5">
                    <label class="form-label" for="search">Search</label>
                    <input id="search" class="form-control" placeholder="Machine name or IP address" @bind="search" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="status">Status</label>
                    <select id="status" class="form-select" @bind="statusFilter">
                        <option value="">Any status</option>
                        @foreach (var status in Enum.GetValues<DeviceStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Apply</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync">Clear</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (devices is null)
            {
                <div class="text-center"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>
            }
            else if (devices.Items.Count == 0)
            {
                <p class="text-muted mb-0">No devices match.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Device</th><th>Status</th><th>Operating system</th><th>IP address</th>
                                <th>Group</th><th>Last seen</th><th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in devices.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@device.MachineName</div>
                                        @foreach (var tag in device.Tags)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@tag</span>
                                        }
                                    </td>
                                    <td><DeviceStatusBadge Status="device.Status" MaintenanceMode="device.MaintenanceMode" /></td>
                                    <td>@device.OperatingSystem <small class="text-muted">@device.Architecture</small></td>
                                    <td>@device.IpAddress</td>
                                    <td>@device.GroupName</td>
                                    <td>@device.LastSeenAt?.ToLocalTime().ToString("g")</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-primary" title="Edit" @onclick="() => Edit(device)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-secondary" title="Collect system info" @onclick="() => CollectSystemInfoAsync(device)"><i class="bi bi-terminal"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" title="Delete" @onclick="() => DeleteAsync(device)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <small class="text-muted">Showing @devices.Items.Count of @devices.TotalCount</small>
            }
        </div>
    </div>
</div>

@if (editing is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">Edit @editing.MachineName</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseEditor"></button>
                    </div>
                    <div class="modal-body">
                        <ErrorAlert @bind-Message="formError" />
                        <div class="mb-3">
                            <label class="form-label" for="group">Group</label>
                            <InputText id="group" class="form-control" @bind-Value="form.GroupName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="tags">Tags</label>
                            <InputText id="tags" class="form-control" placeholder="Comma-separated, e.g. server, finance" @bind-Value="form.Tags" />
                        </div>
                        <div class="form-check">
                            <InputCheckbox id="maintenance" class="form-check-input" @bind-Value="form.MaintenanceMode" />
                            <label class="form-check-label" for="maintenance">Maintenance mode (planned downtime)</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditor">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private PagedResult<DeviceDto>? devices;
    private string? search;
    private string statusFilter = string.Empty;
    private bool isLoading;
    private string? error;

    private DeviceDto? editing;
    private DeviceForm form = new();
    private string? formError;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        Hub.OnDeviceChanged += OnDeviceEvent;
        Hub.OnDeviceDeleted += OnDeviceEvent;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            DeviceStatus? status = Enum.TryParse<DeviceStatus>(statusFilter, out var parsed) ? parsed : null;
            devices = await Api.GetDevicesAsync(status, search);
        }
        catch (Exception ex)
        {
            error = $"Could not load devices: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task ClearFiltersAsync()
    {
        search = null;
        statusFilter = string.Empty;
        return LoadAsync();
    }

    private void Edit(DeviceDto device)
    {
        editing = device;
        formError = null;
        form = new DeviceForm
        {
            GroupName = device.GroupName,
            Tags = string.Join(", ", device.Tags),
            MaintenanceMode = device.MaintenanceMode,
        };
    }

    private void CloseEditor() => editing = null;

    private async Task SaveAsync()
    {
        isSaving = true;
        try
        {
            await Api.UpdateDeviceAsync(editing!.Id, new UpdateDeviceRequest
            {
                GroupName = form.GroupName,
                Tags = (form.Tags ?? string.Empty).Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries),
                MaintenanceMode = form.MaintenanceMode,
            });
            editing = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync(DeviceDto device)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete {device.MachineName}? Its agents, telemetry and command history will be removed."))
            return;
        try
        {
            await Api.DeleteDeviceAsync(device.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not delete {device.MachineName}: {ex.Message}";
        }
    }

    private async Task CollectSystemInfoAsync(DeviceDto device)
    {
        try
        {
            await Api.CreateCommandAsync(device.Id, new CreateCommandRequest { Type = CommandType.CollectSystemInfo });
        }
        catch (Exception ex)
        {
            error = $"Could not queue the command: {ex.Message}";
        }
    }

    private Task OnDeviceEvent<T>(T _) => InvokeAsync(async () =>
    {
        if (editing is not null)
            return;
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Hub.OnDeviceChanged -= OnDeviceEvent;
        Hub.OnDeviceDeleted -= OnDeviceEvent;
    }

    private sealed class DeviceForm
    {
        [System.ComponentModel.DataAnnotations.StringLength(100)]
        public string? GroupName { get; set; }

        public string? Tags { get; set; }

        public bool MaintenanceMode { get; set; }
    }
}
