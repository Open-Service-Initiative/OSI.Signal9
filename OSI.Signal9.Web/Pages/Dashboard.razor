@page "/"
@inject Signal9ApiClient Api
@inject DashboardHubConnection Hub
@implements IDisposable

<PageTitle>Dashboard - Signal9 RMM</PageTitle>

<div class="container-fluid">
    <div class="mb-4">
        <h1>Dashboard</h1>
        <p class="text-muted">Fleet overview across all tenants</p>
    </div>

    <ErrorAlert @bind-Message="error" />

    <div class="row">
        <StatCard Title="Devices" Value="@totalAgents" Icon="bi-pc-display" Color="bg-primary" />
        <StatCard Title="Online" Value="@onlineAgents" Icon="bi-check-circle" Color="bg-success" />
        <StatCard Title="Offline" Value="@offlineAgents" Icon="bi-x-circle" Color="bg-danger" />
        <StatCard Title="Tenants" Value="@totalTenants" Icon="bi-building" Color="bg-info" />
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Recently seen devices</h5>
            <a href="devices" class="btn btn-sm btn-outline-primary">All devices</a>
        </div>
        <div class="card-body">
            @if (recentAgents is null)
            {
                <div class="text-center"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>
            }
            else if (recentAgents.Count == 0)
            {
                <p class="text-muted mb-0">No devices have enrolled yet. Install the agent on a machine with a tenant code to enroll it.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Device</th><th>Status</th><th>Operating system</th><th>Last seen</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var agent in recentAgents)
                            {
                                <tr>
                                    <td>@agent.MachineName</td>
                                    <td><AgentStatusBadge Status="agent.Status" /></td>
                                    <td>@agent.OperatingSystem</td>
                                    <td>@agent.LastSeenAt.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int? totalAgents, onlineAgents, offlineAgents, totalTenants;
    private List<AgentDto>? recentAgents;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Hub.OnAgentChanged += OnAgentEvent;
        Hub.OnAgentDeleted += OnAgentEvent;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            // Page totals give the counts without downloading every agent.
            var all = Api.GetAgentsAsync(pageSize: 100);
            var online = Api.GetAgentsAsync(AgentStatus.Online, pageSize: 1);
            var offline = Api.GetAgentsAsync(AgentStatus.Offline, pageSize: 1);
            var tenants = Api.GetTenantsAsync(pageSize: 1);
            await Task.WhenAll(all, online, offline, tenants);

            totalAgents = all.Result.TotalCount;
            onlineAgents = online.Result.TotalCount;
            offlineAgents = offline.Result.TotalCount;
            totalTenants = tenants.Result.TotalCount;
            recentAgents = all.Result.Items.OrderByDescending(a => a.LastSeenAt).Take(10).ToList();
        }
        catch (Exception ex)
        {
            error = $"Could not load the dashboard: {ex.Message}";
            recentAgents ??= [];
        }
    }

    private Task OnAgentEvent<T>(T _) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Hub.OnAgentChanged -= OnAgentEvent;
        Hub.OnAgentDeleted -= OnAgentEvent;
    }
}
