@inherits FluentDialogInstance
@inject TimeProvider Time

<FluentDialogBody>
    <div class="dialog-form">
        @switch (Method)
        {
            case TokenEndpointAuthMethods.SelfSignedTlsClientAuth:
                <FluentTextArea Id="credential-pem" Label="Self-signed certificate (PEM)" Required="true" @bind-Value="pem" />
                <FluentText>Only the certificate: never send its private key.</FluentText>
                break;
            case TokenEndpointAuthMethods.PrivateKeyJwt:
                <FluentTextArea Id="credential-pem" Label="Public key or certificate (PEM)" Required="true" @bind-Value="pem" />
                <FluentText>RSA of 2048 bits or more, or EC on P-256, P-384 or P-521. Only the public part: never send the private key.</FluentText>
                break;
            default:
                <FluentTextInput Id="credential-days" Label="Expires after (days, at most 365)" TextInputType="TextInputType.Number" @bind-Value="days" />
                <FluentText>Signal9 generates the secret and shows it once. Prefer a certificate or private_key_jwt where you can.</FluentText>
                break;
        }
    </div>
</FluentDialogBody>

@code {
    [Parameter] public string Method { get; set; } = "";

    private string? pem = string.Empty;
    private string? days = "180";

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer)
    {
        footer.PrimaryAction.Label = "Add";
        footer.SecondaryAction.Label = "Cancel";
    }

    protected override Task OnActionClickedAsync(bool primary)
    {
        if (!primary)
            return DialogInstance.CancelAsync();
        var isPublicKey = pem?.Contains("BEGIN PUBLIC KEY", StringComparison.Ordinal) == true;
        return DialogInstance.CloseAsync(Method switch
        {
            TokenEndpointAuthMethods.SelfSignedTlsClientAuth => new CreateApiApplicationCredentialRequest { CertificatePem = pem },
            TokenEndpointAuthMethods.PrivateKeyJwt => isPublicKey
                ? new CreateApiApplicationCredentialRequest { PublicKeyPem = pem }
                : new CreateApiApplicationCredentialRequest { CertificatePem = pem },
            _ => new CreateApiApplicationCredentialRequest
            {
                ExpiresAt = int.TryParse(days, out var d) ? Time.GetUtcNow().AddDays(d) : null,
            },
        });
    }
}
