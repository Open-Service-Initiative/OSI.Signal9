@page "/devices"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Signal9.Shared.DTOs
@using Signal9.Shared.DTOs.Common
@using Signal9.Shared.DTOs.Core
@using Signal9.Shared.Models
@using Signal9.Web.Services
@inject IDashboardService DashboardService
@inject IJSRuntime JSRuntime

<PageTitle>Devices - Signal9 RMM</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>Device Management</h1>
                    <p class="text-muted">Monitor and manage all connected devices</p>
                </div>
                <div>
                    <button class="btn btn-primary" @onclick="ShowCreateModal">
                        <span class="material-icons me-2" style="font-size: 18px;">add</span> Add Device
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="RefreshData">
                        <span class="material-icons me-2" style="font-size: 18px;">refresh</span> Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-3">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input type="text" class="form-control" placeholder="Search devices..." @bind="searchTerm" @oninput="OnSearchChanged" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select class="form-select" @bind="filterStatus">
                                <option value="">All Status</option>
                                <option value="Online">Online</option>
                                <option value="Offline">Offline</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Error">Error</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Platform</label>
                            <select class="form-select" @bind="filterPlatform">
                                <option value="">All Platforms</option>
                                <option value="Windows">Windows</option>
                                <option value="Linux">Linux</option>
                                <option value="macOS">macOS</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Group</label>
                            <input type="text" class="form-control" placeholder="Group name" @bind="filterGroup" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">&nbsp;</label>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary" @onclick="ApplyFilters">Apply Filters</button>
                                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5>Online</h5>
                            <h3>@onlineCount</h3>
                        </div>
                        <i class="bi bi-check-circle fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5>Offline</h5>
                            <h3>@offlineCount</h3>
                        </div>
                        <i class="bi bi-x-circle fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5>Maintenance</h5>
                            <h3>@maintenanceCount</h3>
                        </div>
                        <i class="bi bi-wrench fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5>Total</h5>
                            <h3>@totalCount</h3>
                        </div>
                        <i class="bi bi-pc-display fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Devices Table -->
    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-header">
                    <h5>Devices (@filteredDevices.Count)</h5>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading devices...</p>
                        </div>
                    }
                    else if (filteredDevices.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Device</th>
                                        <th>Status</th>
                                        <th>Platform</th>
                                        <th>IP Address</th>
                                        <th>Group</th>
                                        <th>Last Seen</th>
                                        <th>Version</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var device in filteredDevices)
                                    {
                                        <tr>
                                            <td>
                                                <div>
                                                    <strong>@device.MachineName</strong>
                                                    <div class="text-muted small">@device.Id</div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-@GetStatusBadgeColor(device.Status.ToString())">
                                                    <i class="bi bi-@GetStatusIcon(device.Status.ToString()) me-1"></i>
                                                    @device.Status
                                                </span>
                                            </td>
                                            <td>
                                                <div>
                                                    @device.OperatingSystem
                                                    @if (!string.IsNullOrEmpty(device.Architecture))
                                                    {
                                                        <div class="text-muted small">@device.Architecture</div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(device.IpAddress))
                                                {
                                                    <code>@device.IpAddress</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(device.GroupName))
                                                {
                                                    <span class="badge bg-info">@device.GroupName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Ungrouped</span>
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    var timeDiff = DateTime.UtcNow - device.LastSeen;
                                                }
                                                <span title="@device.LastSeen.ToString("yyyy-MM-dd HH:mm:ss")">
                                                    @FormatTimeAgo(timeDiff)
                                                </span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(device.Version))
                                                {
                                                    <code>@device.Version</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-primary btn-sm" @onclick="() => EditDevice(device)" title="Edit Device">
                                                        <span class="material-icons" style="font-size: 16px;">edit</span>
                                                    </button>
                                                    <button class="btn btn-info btn-sm" @onclick="() => ViewDeviceDetails(device)" title="View Details">
                                                        <span class="material-icons" style="font-size: 16px;">visibility</span>
                                                    </button>
                                                    <button class="btn btn-warning btn-sm" @onclick="() => SendCommand(device)" title="Send Command">
                                                        <span class="material-icons" style="font-size: 16px;">terminal</span>
                                                    </button>
                                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteDevice(device)" title="Delete Device">
                                                        <span class="material-icons" style="font-size: 16px;">delete</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-pc-display display-1 text-muted"></i>
                            <h5 class="mt-3">No devices found</h5>
                            <p class="text-muted">Try adjusting your search criteria or add a new device.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingDevice != null ? "Edit Device" : "Register New Device")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="deviceForm" OnValidSubmit="SaveDevice">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Machine Name *</label>
                                <InputText class="form-control" @bind-Value="deviceForm.MachineName" placeholder="WORKSTATION-01" />
                                <ValidationMessage For="() => deviceForm.MachineName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Operating System *</label>
                                <InputText class="form-control" @bind-Value="deviceForm.OperatingSystem" placeholder="Windows 11" />
                                <ValidationMessage For="() => deviceForm.OperatingSystem" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Architecture</label>
                                <InputSelect class="form-select" @bind-Value="deviceForm.Architecture">
                                    <option value="">Select architecture...</option>
                                    <option value="x64">x64</option>
                                    <option value="x86">x86</option>
                                    <option value="ARM64">ARM64</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">IP Address</label>
                                <InputText class="form-control" @bind-Value="deviceForm.IpAddress" placeholder="192.168.1.100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Group Name</label>
                                <InputText class="form-control" @bind-Value="deviceForm.GroupName" placeholder="Workstations" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Status</label>
                                <InputSelect class="form-select" @bind-Value="deviceForm.Status">
                                    <option value="Online">Online</option>
                                    <option value="Offline">Offline</option>
                                    <option value="Maintenance">Maintenance</option>
                                    <option value="Error">Error</option>
                                </InputSelect>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Tags (JSON)</label>
                                <InputTextArea class="form-control" @bind-Value="deviceForm.TagsJson" rows="3" placeholder='{"department": "IT", "location": "Building A"}' />
                                <div class="form-text">Enter tags as JSON key-value pairs</div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            @(editingDevice != null ? "Update" : "Register") Device
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool showModal = false;
    private bool isSubmitting = false;
    private AgentDto? editingDevice = null;

    private List<AgentDto> devices = [];
    private List<AgentDto> filteredDevices = [];

    // Filters
    private string searchTerm = string.Empty;
    private string filterStatus = string.Empty;
    private string filterPlatform = string.Empty;
    private string filterGroup = string.Empty;

    // Statistics
    private int onlineCount = 0;
    private int offlineCount = 0;
    private int maintenanceCount = 0;
    private int totalCount = 0;

    // Form model
    private DeviceFormModel deviceForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
    }

    private async Task LoadDevices()
    {
        try
        {
            isLoading = true;
            var devicesData = await DashboardService.GetDevicesAsync();
            devices = devicesData.ToList();
            UpdateStatistics();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading devices: {ex.Message}");
            // TODO: Show user-friendly error message
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateStatistics()
    {
        totalCount = devices.Count;
        onlineCount = devices.Count(d => d.Status == AgentStatus.Online);
        offlineCount = devices.Count(d => d.Status == AgentStatus.Offline);
        maintenanceCount = devices.Count(d => d.Status == AgentStatus.Maintenance);
    }

    private void ApplyFilters()
    {
        filteredDevices = devices.Where(d =>
            (string.IsNullOrEmpty(searchTerm) ||
             d.MachineName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             d.Id.ToString().Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (!string.IsNullOrEmpty(d.IpAddress) && d.IpAddress.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrEmpty(filterStatus) || d.Status.ToString() == filterStatus) &&
            (string.IsNullOrEmpty(filterPlatform) || d.OperatingSystem.Contains(filterPlatform, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterGroup) || (!string.IsNullOrEmpty(d.GroupName) && d.GroupName.Contains(filterGroup, StringComparison.OrdinalIgnoreCase)))
        ).ToList();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
        await Task.Delay(1); // Force re-render
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        filterStatus = string.Empty;
        filterPlatform = string.Empty;
        filterGroup = string.Empty;
        ApplyFilters();
    }

    private async Task RefreshData()
    {
        await LoadDevices();
    }

    private void ShowCreateModal()
    {
        editingDevice = null;
        deviceForm = new DeviceFormModel();
        showModal = true;
    }

    private void EditDevice(AgentDto device)
    {
        editingDevice = device;
        deviceForm = new DeviceFormModel
        {
            MachineName = device.MachineName,
            OperatingSystem = device.OperatingSystem,
            Architecture = device.Architecture,
            IpAddress = device.IpAddress,
            GroupName = device.GroupName,
            Status = device.Status.ToString(),
            TagsJson = "{}" // TODO: Serialize device tags
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingDevice = null;
        deviceForm = new DeviceFormModel();
    }

    private async Task SaveDevice()
    {
        try
        {
            isSubmitting = true;

            if (editingDevice != null)
            {
                // Update existing device
                var updateRequest = new AgentUpdateRequest
                {
                    ParentId = editingDevice.ParentId,
                    MachineName = deviceForm.MachineName,
                    IpAddress = deviceForm.IpAddress,  // Fixed: was Description (doesn't exist)
                    // Tags = deviceForm.GroupName,  // Fixed: Tags property doesn't exist in AgentUpdateRequest
                    // Status = Enum.TryParse<AgentStatus>(deviceForm.Status, out var status) ? status : null  // Fixed: Status property doesn't exist
                };

                await DashboardService.UpdateDeviceAsync(editingDevice.Id.ToString(), updateRequest);
            }
            else
            {
                // Create new device
                var createRequest = new AgentRegistrationRequest
                {
                    AgentId = Guid.NewGuid().ToString(),
                    TenantCode = "default", // TODO: Get from context
                    MachineName = deviceForm.MachineName!,
                    OperatingSystem = deviceForm.OperatingSystem!,
                    OSVersion = "Unknown",  // Fixed: Required property was missing
                    IpAddress = deviceForm.IpAddress!,
                    Architecture = deviceForm.Architecture ?? "Unknown",
                    Version = "1.0.0",
                    ParentId = Guid.NewGuid() // Fixed: was TenantId, now ParentId for unified hierarchy
                };

                await DashboardService.CreateDeviceAsync(createRequest);
            }

            CloseModal();
            await LoadDevices();
            await JSRuntime.InvokeVoidAsync("alert", $"Device {(editingDevice != null ? "updated" : "registered")} successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving device: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteDevice(AgentDto device)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete device '{device.MachineName}'?"))
        {
            try
            {
                await DashboardService.DeleteDeviceAsync(device.Id.ToString());
                await LoadDevices();
                await JSRuntime.InvokeVoidAsync("alert", "Device deleted successfully!");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting device: {ex.Message}");
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting device: {ex.Message}");
            }
        }
    }

    private void ViewDeviceDetails(AgentDto device)
    {
        // TODO: Navigate to device details page
        JSRuntime.InvokeVoidAsync("alert", $"View details for {device.MachineName} - Feature coming soon!");
    }

    private void SendCommand(AgentDto device)
    {
        // TODO: Open command execution modal
        JSRuntime.InvokeVoidAsync("alert", $"Send command to {device.MachineName} - Feature coming soon!");
    }

    private string GetStatusBadgeColor(string status) => status switch
    {
        "Online" => "success",
        "Offline" => "danger",
        "Maintenance" => "warning",
        "Error" => "danger",
        _ => "secondary"
    };

    private string GetStatusIcon(string status) => status switch
    {
        "Online" => "check-circle",
        "Offline" => "x-circle",
        "Maintenance" => "wrench",
        "Error" => "exclamation-triangle",
        _ => "question-circle"
    };

    private string FormatTimeAgo(TimeSpan timeDiff)
    {
        var totalMinutes = timeDiff.TotalMinutes;
        if (totalMinutes < 1) return "Just now";
        if (totalMinutes < 60) return $"{(int)totalMinutes}m ago";
        if (totalMinutes < 1440) return $"{(int)timeDiff.TotalHours}h ago";
        return $"{(int)timeDiff.TotalDays}d ago";
    }

    public class DeviceFormModel
    {
        [Required]
        public string? MachineName { get; set; }

        [Required]
        public string? OperatingSystem { get; set; }

        public string? Architecture { get; set; }

        public string? IpAddress { get; set; }

        public string? GroupName { get; set; }

        public string? Description { get; set; }

        public string Status { get; set; } = "Online";

        public string TagsJson { get; set; } = "{}";
    }
}
