@page "/tenants"
@using Signal9.Web.Services
@using Signal9.Shared.DTOs.Tenants
@using Signal9.Shared.DTOs.Common
@using Signal9.Shared.Models
@using System.ComponentModel.DataAnnotations
@inject IDashboardService DashboardService
@inject IJSRuntime JSRuntime

<PageTitle>Tenants - Signal9 RMM</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1>Tenant Management</h1>
                    <p class="text-muted">Manage organizations, sites, and departments</p>
                </div>
                <div>
                    <button class="btn btn-primary" @onclick="ShowCreateModal">
                        <span class="material-icons me-2" style="font-size: 18px;">add</span> Add Tenant
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="RefreshData">
                        <span class="material-icons me-2" style="font-size: 18px;">refresh</span> Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-3">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input type="text" class="form-control" placeholder="Search tenants..." @bind="searchTerm" @oninput="OnSearchChanged" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Type</label>
                            <select class="form-select" @bind="filterType">
                                <option value="">All Types</option>
                                <option value="Organization">Organization</option>
                                <option value="Site">Site</option>
                                <option value="Department">Department</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select class="form-select" @bind="filterActive">
                                <option value="">All Status</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Plan</label>
                            <select class="form-select" @bind="filterPlan">
                                <option value="">All Plans</option>
                                <option value="Basic">Basic</option>
                                <option value="Professional">Professional</option>
                                <option value="Enterprise">Enterprise</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">&nbsp;</label>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary" @onclick="ApplyFilters">Apply Filters</button>
                                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tenants Table -->
    <div class="row">
        <div class="col">
            <div class="card">
                <div class="card-header">
                    <h5>Tenants (@filteredTenants.Count)</h5>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading tenants...</p>
                        </div>
                    }
                    else if (filteredTenants.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Name</th>
                                        <th>Code</th>
                                        <th>Type</th>
                                        <th>Plan</th>
                                        <th>Agents</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tenant in filteredTenants)
                                    {
                                        <tr>
                                            <td>
                                                <div>
                                                    <strong>@tenant.Name</strong>
                                                    @if (!string.IsNullOrEmpty(tenant.Description))
                                                    {
                                                        <div class="text-muted small">@tenant.Description</div>
                                                    }
                                                </div>
                                            </td>
                                            <td><code>@tenant.Slug</code></td>
                                            <td>
                                                <span class="badge bg-info">@tenant.TenantType</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@GetPlanBadgeColor(tenant.Plan?.ToString() ?? "Unknown")">@(tenant.Plan?.ToString() ?? "Unknown")</span>
                                            </td>
                                            <td>@tenant.AgentCount / @tenant.MaxAgents</td>
                                            <td>
                                                <span class="badge bg-@((tenant.IsActive ?? false) ? "success" : "danger")">
                                                    @((tenant.IsActive ?? false) ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>@(tenant.CreatedAt.ToString("MMM dd, yyyy"))</td>  // Fixed: removed nullable check
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-primary btn-sm" @onclick="() => EditTenant(tenant)" title="Edit Tenant">
                                                        <span class="material-icons" style="font-size: 16px;">edit</span>
                                                    </button>
                                                    <button class="btn btn-info btn-sm" @onclick="() => ViewTenantDetails(tenant)" title="View Details">
                                                        <span class="material-icons" style="font-size: 16px;">visibility</span>
                                                    </button>
                                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteTenant(tenant)" title="Delete Tenant">
                                                        <span class="material-icons" style="font-size: 16px;">delete</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-building display-1 text-muted"></i>
                            <h5 class="mt-3">No tenants found</h5>
                            <p class="text-muted">Try adjusting your search criteria or add a new tenant.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
@if (showModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingTenant != null ? "Edit Tenant" : "Create New Tenant")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="tenantForm" OnValidSubmit="SaveTenant">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Name *</label>
                                <InputText class="form-control" @bind-Value="tenantForm.Name" placeholder="Enter tenant name" />
                                <ValidationMessage For="() => tenantForm.Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Code *</label>
                                <InputText class="form-control" @bind-Value="tenantForm.Code" placeholder="ACME" />
                                <ValidationMessage For="() => tenantForm.Code" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <InputTextArea class="form-control" @bind-Value="tenantForm.Description" rows="3" placeholder="Optional description" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tenant Type *</label>
                                <InputSelect class="form-select" @bind-Value="tenantForm.TenantType">
                                    <option value="">Select type...</option>
                                    <option value="Organization">Organization</option>
                                    <option value="Site">Site</option>
                                    <option value="Department">Department</option>
                                </InputSelect>
                                <ValidationMessage For="() => tenantForm.TenantType" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Plan *</label>
                                <InputSelect class="form-select" @bind-Value="tenantForm.Plan">
                                    <option value="">Select plan...</option>
                                    <option value="Basic">Basic</option>
                                    <option value="Professional">Professional</option>
                                    <option value="Enterprise">Enterprise</option>
                                    <option value="Custom">Custom</option>
                                </InputSelect>
                                <ValidationMessage For="() => tenantForm.Plan" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contact Email</label>
                                <InputText class="form-control" @bind-Value="tenantForm.ContactEmail" type="email" placeholder="admin@example.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contact Phone</label>
                                <InputText class="form-control" @bind-Value="tenantForm.ContactPhone" placeholder="+1-555-0123" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Max Agents</label>
                                <InputNumber class="form-control" @bind-Value="tenantForm.MaxAgents" min="1" max="10000" />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mt-4">
                                    <InputCheckbox class="form-check-input" @bind-Value="tenantForm.IsActive" />
                                    <label class="form-check-label">Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            @(editingTenant != null ? "Update" : "Create") Tenant
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool showModal = false;
    private bool isSubmitting = false;
    private TenantResponse? editingTenant = null;

    private List<TenantResponse> tenants = new();
    private List<TenantResponse> filteredTenants = new();

    // Filters
    private string searchTerm = string.Empty;
    private string filterType = string.Empty;
    private string filterActive = string.Empty;
    private string filterPlan = string.Empty;

    // Form model
    private TenantFormModel tenantForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        try
        {
            isLoading = true;
            var tenantsData = await DashboardService.GetTenantsAsync();
            tenants = tenantsData.ToList();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tenants: {ex.Message}");
            // TODO: Show user-friendly error message
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredTenants = tenants.Where(t =>
            (string.IsNullOrEmpty(searchTerm) || 
             t.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (t.Slug?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
             (!string.IsNullOrEmpty(t.Description) && t.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrEmpty(filterType) || t.TenantType == filterType) &&
            (string.IsNullOrEmpty(filterActive) || t.IsActive.ToString().Equals(filterActive, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterPlan) || t.Plan.ToString() == filterPlan)
        ).ToList();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
        await Task.Delay(1); // Force re-render
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        filterType = string.Empty;
        filterActive = string.Empty;
        filterPlan = string.Empty;
        ApplyFilters();
    }

    private async Task RefreshData()
    {
        await LoadTenants();
    }

    private void ShowCreateModal()
    {
        editingTenant = null;
        tenantForm = new TenantFormModel();
        showModal = true;
    }

    private void EditTenant(TenantResponse tenant)
    {
        editingTenant = tenant;
        tenantForm = new TenantFormModel
        {
            Name = tenant.Name,
            Code = tenant.Slug,
            Description = tenant.Description,
            TenantType = tenant.TenantType,
            Plan = tenant.Plan?.ToString() ?? "Standard",
            ContactEmail = tenant.ContactEmail,
            ContactPhone = tenant.ContactPhone,
            MaxAgents = tenant.MaxAgents ?? 10,
            IsActive = tenant.IsActive ?? false
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingTenant = null;
        tenantForm = new TenantFormModel();
    }

    private async Task SaveTenant()
    {
        try
        {
            isSubmitting = true;
            
            Console.WriteLine($"SaveTenant - editingTenant is null: {editingTenant == null}");

            if (editingTenant != null)
            {
                Console.WriteLine($"Updating tenant: {editingTenant.Id}");
                // Update existing tenant
                var updateRequest = new UpdateTenantRequest
                {
                    TenantId = editingTenant.Id.ToString(),  // Fixed: Convert Guid to string
                    Name = tenantForm.Name,
                    Description = tenantForm.Description,
                    TenantType = tenantForm.TenantType,
                    ContactEmail = tenantForm.ContactEmail,
                    ContactPhone = tenantForm.ContactPhone,
                    MaxAgents = tenantForm.MaxAgents,
                    IsActive = tenantForm.IsActive
                };

                await DashboardService.UpdateTenantAsync(editingTenant.Id, updateRequest);  // Fixed: removed Guid.Parse
            }
            else
            {
                // Create new tenant
                var createRequest = new CreateTenantRequest
                {
                    TenantSlug = tenantForm.Code!,
                    TenantId = Guid.Empty, // Will be set by the service
                    Name = tenantForm.Name!,
                    Description = tenantForm.Description,
                    TenantType = tenantForm.TenantType!,
                    Plan = tenantForm.Plan!,
                    ContactEmail = tenantForm.ContactEmail!,
                    ContactPhone = tenantForm.ContactPhone,
                    MaxAgents = tenantForm.MaxAgents
                };

                await DashboardService.CreateTenantAsync(createRequest);
            }

            var isUpdate = editingTenant != null;
            CloseModal();
            await LoadTenants();
            await JSRuntime.InvokeVoidAsync("alert", $"Tenant {(isUpdate ? "updated" : "created")} successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving tenant: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteTenant(TenantResponse tenant)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete tenant '{tenant.Name}'?"))
        {
            try
            {
                await DashboardService.DeleteTenantAsync(tenant.Id);  // Fixed: removed Guid.Parse
                await LoadTenants();
                await JSRuntime.InvokeVoidAsync("alert", "Tenant deleted successfully!");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting tenant: {ex.Message}");
                await JSRuntime.InvokeVoidAsync("alert", $"Error deleting tenant: {ex.Message}");
            }
        }
    }

    private void ViewTenantDetails(TenantResponse tenant)
    {
        // TODO: Navigate to tenant details page
        JSRuntime.InvokeVoidAsync("alert", $"View details for {tenant.Name} - Feature coming soon!");
    }

    private string GetPlanBadgeColor(string plan) => plan switch
    {
        "Basic" => "secondary",
        "Professional" => "primary",
        "Enterprise" => "success",
        "Custom" => "warning",
        _ => "light"
    };

    public class TenantFormModel
    {
        [Required]
        public string? Name { get; set; }

        [Required]
        public string? Code { get; set; }

        public string? Description { get; set; }

        [Required]
        public string? TenantType { get; set; }

        [Required]
        public string? Plan { get; set; }

        public string? ContactEmail { get; set; }

        public string? ContactPhone { get; set; }

        [Range(1, 10000)]
        public int MaxAgents { get; set; } = 10;

        public bool IsActive { get; set; } = true;
    }
}
